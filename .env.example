# Render PostgreSQL connection values
# Use the Internal Database URL/host details shown by your Render PostgreSQL service.
DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=DATABASE_USER
DB_PASSWORD=DATABASE_PASSWORD

# Use a long random secret (32+ characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRATION_HOURS=24

# After deploying the frontend, put its exact Render URL here.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com
